# ==============================================
# VIBE KANBAN - COOLIFY DEPLOYMENT CONFIG
# ==============================================
# This file contains all environment variables needed for Coolify deployment
# Copy this to .env and configure the values for your deployment

# ==============================================
# REQUIRED - CORE CONFIGURATION
# ==============================================

# Domain where Vibe Kanban will be accessible
SERVICE_FQDN=kanban.example.com

# Email for Let's Encrypt SSL certificate generation  
ACME_EMAIL=admin@example.com

# Strong JWT secret for session management (generate with: openssl rand -base64 48)
VIBEKANBAN_REMOTE_JWT_SECRET=changeme-please-use-secure-random-string

# ==============================================
# REQUIRED - DATABASE CONFIGURATION
# ==============================================

# PostgreSQL database configuration
POSTGRES_DB=remote
POSTGRES_USER=remote
POSTGRES_PASSWORD=changeme

# Electric sync role password (should match POSTGRES_PASSWORD or be unique)
ELECTRIC_ROLE_PASSWORD=changeme

# ==============================================
# REQUIRED - OAUTH PROVIDERS
# ==============================================
# Configure at least one OAuth provider for user authentication

# GitHub OAuth (https://github.com/settings/developers)
# Callback URL: https://your-domain.com/v1/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)  
# Redirect URI: https://your-domain.com/v1/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ==============================================
# OPTIONAL - ANALYTICS & MONITORING
# ==============================================

# PostHog analytics (build-time configuration)
POSTHOG_API_KEY=
POSTHOG_API_ENDPOINT=

# Rust logging level
RUST_LOG=info,remote=info

# ==============================================
# OPTIONAL - EMAIL INTEGRATION
# ==============================================

# Loops.so email API for invitation emails
LOOPS_EMAIL_API_KEY=

# ==============================================
# OPTIONAL - GITHUB APP INTEGRATION
# ==============================================

# GitHub App for enhanced repository integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# ==============================================
# OPTIONAL - BILLING & SUBSCRIPTIONS (STRIPE)
# ==============================================

# Stripe configuration for billing features
STRIPE_SECRET_KEY=
STRIPE_TEAM_SEAT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_SEAT_LIMIT=1

# ==============================================
# OPTIONAL - STORAGE CONFIGURATION
# ==============================================

# Azure Blob Storage (defaults to local Azurite container)
AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
AZURE_STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_CONTAINER_NAME=issue-attachments
AZURE_STORAGE_ENDPOINT_URL=http://azurite:10000/devstoreaccount1

# Cloudflare R2 (alternative to Azure Blob Storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REVIEW_ENDPOINT=
R2_REVIEW_BUCKET=
REVIEW_WORKER_BASE_URL=

# ==============================================
# COOLIFY INTEGRATION NOTES
# ==============================================

# 1. SERVICE_FQDN will be auto-configured by Coolify with your domain
# 2. Generate secure passwords for POSTGRES_PASSWORD, ELECTRIC_ROLE_PASSWORD, and VIBEKANBAN_REMOTE_JWT_SECRET
# 3. Configure at least one OAuth provider (GitHub or Google)
# 4. ACME_EMAIL should be a valid email for SSL certificate notifications
# 5. All OPTIONAL sections can be left empty for basic deployment

# ==============================================
# SECURITY BEST PRACTICES
# ==============================================

# - Never use default passwords in production
# - Store OAuth secrets securely in Coolify's environment variables
# - Regenerate JWT secret for each deployment
# - Use strong, unique passwords for database credentials
# - Review and update dependencies regularly